VITE_SUPABASE_URL=https://fybrptjsdubegufwdsrk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLOCA_AQUI_A_CHAVE_PUBLICA

# Opcional: só servidor. Nunca usar com prefixo VITE_.
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: fotografia do banner da página inicial (só https)
# VITE_CAMPAIGN_IMAGE_URL=https://.../campanha-outono.jpg

# Fornecedores por API (só servidor — nunca com prefixo VITE_)
# CJ_API_KEY=
# BIGBUY_API_KEY=
# BIGBUY_TAXONOMIES=          # ids das categorias BigBuy da loja, separados por vírgula
# BIGBUY_SANDBOX=1            # opcional, para testar no sandbox
# PRINTFUL_TOKEN=
# PRINTFUL_STORE_ID=          # opcional, com tokens de conta
# Sincronização periódica: POST /api/cron/sync-stock com "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=                # 32+ caracteres aleatórios (openssl rand -hex 32)
# VERCEL_CRON_SCHEDULE=       # só no Vercel Pro, ex.: */15 * * * *  (Hobby: uma vez por dia)
# SUPABASE_SERVICE_ROLE_KEY=  # necessário só para a sincronização periódica
